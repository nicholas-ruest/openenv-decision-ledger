FROM python:3.12-slim@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe
WORKDIR /app
LABEL org.opencontainers.image.source="https://github.com/nicholas-ruest/openenv-decision-ledger"
LABEL org.opencontainers.image.description="Software-category training preparation; paid execution locked, no model weights"
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY training/requirements-cuda.lock /app/requirements-cuda.lock
RUN pip install --no-cache-dir -r requirements-cuda.lock && pip check && useradd --uid 10001 --create-home arena
COPY training /app/training
COPY config/private-training-preparation.json /app/config/private-training-preparation.json
COPY config/target-model-manifest.json /app/config/target-model-manifest.json
COPY integrations/openenv-arena/arena_env /app/arena_env
COPY integrations/openenv-arena/arena_env /app/integrations/openenv-arena/arena_env
COPY tests/training /app/tests/training
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1
USER 10001
CMD ["python", "-m", "training.session", "--execute"]
